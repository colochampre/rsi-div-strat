//@version=5
// ============================================================================
// RSI DIVERGENCE STRATEGY
// RSI -> Divergences -> Entries -> Exits -> Risk -> Plots
// ============================================================================
strategy(
     title                    = "RSI Divergence Strategy",
     shorttitle               = "RSI Divergences v1.3",
     overlay                  = false,
     initial_capital          = 1000,
     default_qty_type         = strategy.percent_of_equity,
     default_qty_value        = 100,
     commission_type          = strategy.commission.percent,
     commission_value         = 0.05,
     calc_on_every_tick       = false,
     process_orders_on_close  = false,
     use_bar_magnifier        = false, // true con plan premium
     max_bars_back            = 500)

// ============================================================================
// 1. RSI — Inputs
// ============================================================================
rsiLen    = input.int(11,    "RSI Length",    minval = 1,               group = "RSI")
ob        = input.int(70,    "Overbought",    minval = 0, maxval = 100, group = "RSI")
osLevel   = input.int(30,    "Oversold",      minval = 0, maxval = 100, group = "RSI")
lookback  = input.int(60,    "Lookback Bars", minval = 1,               group = "RSI")
obosOnly  = input.bool(true, "Only divergences inside OB/OS zones",     group = "RSI")
allowBull = input.bool(true, "Bullish Divergences",                     group = "RSI")
allowBear = input.bool(true, "Bearish Divergences",                     group = "RSI")

// ============================================================================
// 2. ENTRIES — Inputs
// ============================================================================
enableLongs  = input.bool(true, "Enable Longs",  group = "ENTRIES")
enableShorts = input.bool(true, "Enable Shorts", group = "ENTRIES")

// ============================================================================
// 3. EXITS — Inputs
// ============================================================================
exitOnOppositeDiv = input.bool(true,  "Exit on opposite divergence",                group = "EXITS")
tpPerc            = input.float(0.0,  "Take Profit %",   minval = 0.0, step = 0.1,  group = "EXITS")
slPerc            = input.float(0.0,  "Stop Loss %",     minval = 0.0, step = 0.1,  group = "EXITS")
useTrailStop      = input.bool(false, "Trailing Stop",                              group = "EXITS")
trailActivPerc    = input.float(1.0,  "Trailing Activation %", minval = 0.1, step = 0.1, group = "EXITS")
trailOffsetPerc   = input.float(0.5,  "Trailing Offset %",     minval = 0.1, step = 0.1, group = "EXITS")

// ============================================================================
// RSI CALCULATION
// ============================================================================
rsi = ta.rsi(close, rsiLen)

// ============================================================================
// SWING DETECTION
// Rastrea el extremo de precio/RSI vigente dentro de la ventana "lookback".
// ============================================================================
var float maxPrice = na
var float maxRsi   = na
var float minPrice = na
var float minRsi   = na

hb = math.abs(ta.highestbars(rsi, lookback))
lb = math.abs(ta.lowestbars(rsi, lookback))

maxPrice := hb == 0 ? close : na(maxPrice[1]) ? close : maxPrice[1]
maxRsi   := hb == 0 ? rsi   : na(maxRsi[1])   ? rsi   : maxRsi[1]
minPrice := lb == 0 ? close : na(minPrice[1]) ? close : minPrice[1]
minRsi   := lb == 0 ? rsi   : na(minRsi[1])   ? rsi   : minRsi[1]

if close > maxPrice
    maxPrice := close
if rsi > maxRsi
    maxRsi := rsi
if close < minPrice
    minPrice := close
if rsi < minRsi
    minRsi := rsi

// ============================================================================
// DIVERGENCE ENGINE
// ============================================================================
bearDiv = allowBear and (maxPrice[1] > maxPrice[2]) and (rsi[1] < maxRsi) and (rsi <= rsi[1]) and (not obosOnly or maxRsi >= ob)
bullDiv = allowBull and (minPrice[1] < minPrice[2]) and (rsi[1] > minRsi) and (rsi >= rsi[1]) and (not obosOnly or minRsi <= osLevel)

// ============================================================================
// SIGNAL GENERATION
// ============================================================================
longSignal  = bullDiv and enableLongs
shortSignal = bearDiv and enableShorts

// ============================================================================
// ENTRY LOGIC
// ============================================================================
if longSignal
    strategy.entry("Long", strategy.long, comment = "Long")
else if shortSignal
    strategy.entry("Short", strategy.short, comment = "Short")

// ============================================================================
// EXIT LOGIC — señal opuesta
// ============================================================================
if exitOnOppositeDiv
    if bearDiv and strategy.position_size > 0
        strategy.close("Long", comment = "Opposite Divergence")
    if bullDiv and strategy.position_size < 0
        strategy.close("Short", comment = "Opposite Divergence")

// ============================================================================
// RISK MANAGEMENT — SL fijo / TP / Trailing
// El stop se recalcula y se reenvía cada vela al mismo id de strategy.exit():
// Pine reemplaza la orden existente en vez de crear otra.
// ============================================================================
longStop  = slPerc > 0 ? strategy.position_avg_price * (1 - slPerc / 100) : na
shortStop = slPerc > 0 ? strategy.position_avg_price * (1 + slPerc / 100) : na

longLimit  = tpPerc > 0 ? strategy.position_avg_price * (1 + tpPerc / 100) : na
shortLimit = tpPerc > 0 ? strategy.position_avg_price * (1 - tpPerc / 100) : na

trailPts = useTrailStop ? (strategy.position_avg_price * trailActivPerc  / 100) / syminfo.mintick : na
trailOff = useTrailStop ? (strategy.position_avg_price * trailOffsetPerc / 100) / syminfo.mintick : na

// Solo mandamos la orden si hay al menos un objetivo real esa vela.
longHasTarget  = not na(longStop)  or not na(longLimit)  or not na(trailPts)
shortHasTarget = not na(shortStop) or not na(shortLimit) or not na(trailPts)

if strategy.position_size > 0 and longHasTarget
    strategy.exit("Long Risk Exit", from_entry = "Long", stop = longStop, limit = longLimit, trail_points = trailPts, trail_offset = trailOff,
         comment_loss = "SL", comment_profit = "TP", comment_trailing = "Trailing")

if strategy.position_size < 0 and shortHasTarget
    strategy.exit("Short Risk Exit", from_entry = "Short", stop = shortStop, limit = shortLimit, trail_points = trailPts, trail_offset = trailOff,
         comment_loss = "SL", comment_profit = "TP", comment_trailing = "Trailing")

// ============================================================================
// STOPS — visualización
// Trailing: reconstruye el nivel que usa strategy.exit(). Distancia FIJA en
// precio (offset % calculado sobre la entrada) medida contra el HIGH/LOW de la
// vela, y recién a partir de que el precio alcanza el nivel de activación.
// Solo se mueve a favor: nunca retrocede mientras dure la posición.
// SL fijo: reusa longStop/shortStop, las mismas series que recibe la orden.
// Ambos stops conviven en la misma strategy.exit(): sale el que toque primero.
// ============================================================================
float slLevel = na
if strategy.position_size > 0
    slLevel := longStop
else if strategy.position_size < 0
    slLevel := shortStop

trailActivPrice = strategy.position_avg_price * trailActivPerc  / 100
trailOffPrice   = strategy.position_avg_price * trailOffsetPerc / 100

float trailActivLevel = na
if useTrailStop and strategy.position_size > 0
    trailActivLevel := strategy.position_avg_price + trailActivPrice
else if useTrailStop and strategy.position_size < 0
    trailActivLevel := strategy.position_avg_price - trailActivPrice

var float trailLevel = na
if not useTrailStop or strategy.position_size == 0
    trailLevel := na
else if strategy.position_size > 0
    if high >= trailActivLevel
        trailLevel := na(trailLevel) ? high - trailOffPrice : math.max(trailLevel, high - trailOffPrice)
else
    if low <= trailActivLevel
        trailLevel := na(trailLevel) ? low + trailOffPrice : math.min(trailLevel, low + trailOffPrice)

// Área de riesgo = entre el precio y el stop VIGENTE. Mientras el trailing no
// esté armado el stop real es el SL fijo; una vez armado el SL deja de serlo,
// así que el área cambia de color en vez de superponerse.
slFillLevel = na(trailLevel) ? slLevel : na

pricePlot  = plot(close,       title = "Fill anchor — price", color = color.new(color.white, 100), force_overlay = true)
slFillPlot = plot(slFillLevel, title = "Fill anchor — SL",    color = color.new(color.white, 100), style = plot.style_linebr, force_overlay = true)

plot(trailActivLevel,  title = "Trailing Activation", color = color.new(color.lime, 20),   linewidth = 1, style = plot.style_linebr, force_overlay = true)
plot(slLevel,          title = "Fixed Stop Loss",     color = color.new(color.red, 20),    linewidth = 1, style = plot.style_linebr, force_overlay = true)
trailPlot = plot(trailLevel, title = "Trailing Stop", color = color.new(color.fuchsia, 20), linewidth = 2, style = plot.style_linebr, force_overlay = true)

fill(pricePlot, slFillPlot, color = color.new(color.red, 90),     title = "Fixed Stop Zone")
fill(pricePlot, trailPlot,  color = color.new(color.fuchsia, 90), title = "Trailing Stop Zone")

// ============================================================================
// PLOTS
// ============================================================================
plot(rsi, title = "RSI", color = color.new(color.yellow, (rsi > ob or rsi < osLevel) ? 0 : 10))
obBand  = hline(ob,      title = "Overbought", color = color.new(color.red, 40))
osBand  = hline(osLevel, title = "Oversold",   color = color.new(color.green, 40))
midBand = hline(50,      title = "Midline",    color = color.new(color.white, 50))
fill(midBand, obBand, color = color.new(color.lime, 90))
fill(osBand, midBand, color = color.new(color.red, 90))

if bearDiv
    label.new(bar_index - 1, rsi[1] + 1, "", color = color.red, textcolor = color.white, style = label.style_label_down, yloc = yloc.price, size = size.small)

if bullDiv
    label.new(bar_index - 1, rsi[1] - 1, "", color = color.green, textcolor = color.white, style = label.style_label_up, yloc = yloc.price, size = size.small)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(bearDiv,     title = "Bearish Divergence", message = "RSI Bearish Divergence")
alertcondition(bullDiv,     title = "Bullish Divergence",  message = "RSI Bullish Divergence")
alertcondition(longSignal,  title = "Long Signal",         message = "Long Entry Signal")
alertcondition(shortSignal, title = "Short Signal",        message = "Short Entry Signal")
