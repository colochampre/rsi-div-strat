//@version=5
// ============================================================================
// RSI DIVERGENCE STRATEGY
// Arquitectura modular: RSI -> Filters -> Entries -> Exits -> Risk -> Plots
// Cada bloque solo depende de lo que el bloque anterior produce.
// ============================================================================
strategy(
     title                    = "RSI Divergence Strategy",
     shorttitle               = "RSI Divergences v1.1",
     overlay                  = false,
     initial_capital          = 10000,
     default_qty_type         = strategy.percent_of_equity,
     default_qty_value        = 10,
     commission_type          = strategy.commission.percent,
     commission_value         = 0.05,
     calc_on_every_tick       = true,
     process_orders_on_close  = false,
     max_bars_back            = 500)

// ============================================================================
// 1. RSI — Inputs
// ============================================================================
rsiLen    = input.int(11,    "RSI Length",    minval = 1,               group = "RSI")
ob        = input.int(70,    "Overbought",    minval = 0, maxval = 100, group = "RSI")
osLevel   = input.int(30,    "Oversold",      minval = 0, maxval = 100, group = "RSI")
lookback  = input.int(60,    "Lookback Bars", minval = 1,               group = "RSI")
obosOnly  = input.bool(true, "Only divergences inside OB/OS zones",     group = "RSI")
allowBull = input.bool(true, "Bullish Divergences",                     group = "RSI")
allowBear = input.bool(true, "Bearish Divergences",                     group = "RSI")

// ============================================================================
// 2. ENTRIES — Inputs
// ============================================================================
enableLongs     = input.bool(true,  "Enable Longs",                        group = "ENTRIES")
enableShorts    = input.bool(true,  "Enable Shorts",                       group = "ENTRIES")
reversePosition = input.bool(true,  "Reverse Position",                    group = "ENTRIES")
cooldownBars    = input.int(0,      "Minimum bars between entries", minval = 0, group = "ENTRIES")

// ============================================================================
// 3. EXITS — Inputs
// ============================================================================
exitOnOppositeDiv = input.bool(true,  "Exit on opposite divergence",              group = "EXITS")
tpPerc            = input.float(0.0,  "Take Profit %",   minval = 0.0, step = 0.1, group = "EXITS")
slPerc            = input.float(0.0,  "Stop Loss %",     minval = 0.0, step = 0.1, group = "EXITS")
useAtrStop        = input.bool(false, "ATR Stop",                                 group = "EXITS")
atrLen            = input.int(14,     "ATR Length",      minval = 1,              group = "EXITS")
atrMult           = input.float(2.0,  "ATR Multiplier",  minval = 0.1, step = 0.1, group = "EXITS")
useTrailStop      = input.bool(false, "Trailing Stop",                                 group = "EXITS")
trailActivPerc    = input.float(1.0,  "Trailing Activation %", minval = 0.1, step = 0.1, group = "EXITS")
trailOffsetPerc   = input.float(0.5,  "Trailing Offset %",     minval = 0.1, step = 0.1, group = "EXITS")

// ============================================================================
// 4. FILTERS — Inputs
// Filtro de estiramiento: exige que el precio esté suficientemente lejos
// (en ATRs) de una EMA rápida para considerar la divergencia como agotamiento
// real, en vez de ruido de un pullback/rango pegado a la media.
// ============================================================================
useStretchFilter = input.bool(true, "Use EMA Stretch Filter",                        group = "FILTERS")
stretchEmaLen     = input.int(20,    "Stretch EMA Length", minval = 1,                group = "FILTERS")
stretchAtrLen     = input.int(14,    "Stretch ATR Length", minval = 1,                group = "FILTERS")
minStretchATR      = input.float(1.0, "Min. Distance from EMA (in ATR)", minval = 0.0, step = 0.1, group = "FILTERS")

// ============================================================================
// 5. VISUALS — Inputs
// ============================================================================
// Innecesario. Si se carga la estrategia se cargan las visuales.
// showRSI       = input.bool(true, "Show RSI",         group = "VISUALS")
// showDiv       = input.bool(true, "Show Divergences", group = "VISUALS")
// showEntries   = input.bool(true, "Show Entries",     group = "VISUALS")
// showExits     = input.bool(true, "Show Exits",       group = "VISUALS")
showRSI       = true
showDiv       = true
showEntries   = false
showExits     = false
// showStretchZone = input.bool(true, "Show Stretch Filter Zone on price", group = "VISUALS")

// ============================================================================
// RSI CALCULATION
// ============================================================================
rsi = ta.rsi(close, rsiLen)

// ============================================================================
// SWING DETECTION
// (rastrea el extremo de precio/RSI vigente dentro de la ventana "lookback")
// ============================================================================
var float maxPrice = na
var float maxRsi   = na
var float minPrice = na
var float minRsi   = na

hb = math.abs(ta.highestbars(rsi, lookback))
lb = math.abs(ta.lowestbars(rsi, lookback))

maxPrice := hb == 0 ? close : na(maxPrice[1]) ? close : maxPrice[1]
maxRsi   := hb == 0 ? rsi   : na(maxRsi[1])   ? rsi   : maxRsi[1]
minPrice := lb == 0 ? close : na(minPrice[1]) ? close : minPrice[1]
minRsi   := lb == 0 ? rsi   : na(minRsi[1])   ? rsi   : minRsi[1]

if close > maxPrice
    maxPrice := close
if rsi > maxRsi
    maxRsi := rsi
if close < minPrice
    minPrice := close
if rsi < minRsi
    minRsi := rsi

// ============================================================================
// DIVERGENCE ENGINE
// Sin inputs propios: solo consume RSI/precio ya calculados arriba.
// Único trabajo: producir bullDiv / bearDiv.
// ============================================================================
bearDiv = allowBear and (maxPrice[1] > maxPrice[2]) and (rsi[1] < maxRsi) and (rsi <= rsi[1]) and (not obosOnly or maxRsi >= ob)
bullDiv = allowBull and (minPrice[1] < minPrice[2]) and (rsi[1] > minRsi) and (rsi >= rsi[1]) and (not obosOnly or minRsi <= osLevel)

// ============================================================================
// FILTERS
// Punto de extensión para futuros filtros de confirmación (Volumen, sesión...).
// Cada filtro nuevo solo agrega una condición acá, sin tocar RSI ni Divergence Engine.
// filtersOk = filtro SIMÉTRICO (aplica igual a longs y shorts).
// bullFilterOk / bearFilterOk = filtros DIRECCIONALES (distintos por lado).
// ============================================================================
filtersOk = true
// Ejemplo simétrico para más adelante:
// volumeOk = volume > ta.sma(volume, 20)
// filtersOk := volumeOk

stretchEma = ta.ema(close, stretchEmaLen)
stretchAtr = ta.atr(stretchAtrLen)
stretch    = (close - stretchEma) / stretchAtr   // positivo = arriba de la EMA, negativo = abajo

bullFilterOk = not useStretchFilter or stretch <= -minStretchATR   // precio estirado ABAJO de la EMA
bearFilterOk = not useStretchFilter or stretch >=  minStretchATR   // precio estirado ARRIBA de la EMA

stretchUpper = stretchEma + minStretchATR * stretchAtr
stretchLower = stretchEma - minStretchATR * stretchAtr

// ============================================================================
// SIGNAL GENERATION
// ============================================================================
longSignal  = bullDiv and filtersOk and bullFilterOk and enableLongs
shortSignal = bearDiv and filtersOk and bearFilterOk and enableShorts

// ============================================================================
// ENTRY LOGIC
// ============================================================================
var int lastEntryBar = na
cooldownOk = na(lastEntryBar) or (bar_index - lastEntryBar) >= cooldownBars

canLong  = reversePosition or strategy.position_size >= 0
canShort = reversePosition or strategy.position_size <= 0

if longSignal and canLong and cooldownOk
    strategy.entry("Long", strategy.long, comment = "Long Entry")
    lastEntryBar := bar_index

if shortSignal and canShort and cooldownOk
    strategy.entry("Short", strategy.short, comment = "Short Entry")
    lastEntryBar := bar_index

// ============================================================================
// EXIT LOGIC — señal opuesta
// ============================================================================
if exitOnOppositeDiv
    if bearDiv and strategy.position_size > 0
        strategy.close("Long", comment = "Opposite Divergence")
    if bullDiv and strategy.position_size < 0
        strategy.close("Short", comment = "Opposite Divergence")

// ============================================================================
// RISK MANAGEMENT — SL / TP / ATR Stop / Trailing
// ============================================================================
atrVal = ta.atr(atrLen)
riskActive = tpPerc > 0 or slPerc > 0 or useAtrStop or useTrailStop

longStop  = useAtrStop ? strategy.position_avg_price - atrVal * atrMult : slPerc > 0 ? strategy.position_avg_price * (1 - slPerc / 100) : na
shortStop = useAtrStop ? strategy.position_avg_price + atrVal * atrMult : slPerc > 0 ? strategy.position_avg_price * (1 + slPerc / 100) : na

longLimit  = tpPerc > 0 ? strategy.position_avg_price * (1 + tpPerc / 100) : na
shortLimit = tpPerc > 0 ? strategy.position_avg_price * (1 - tpPerc / 100) : na

trailPts = useTrailStop ? (strategy.position_avg_price * trailActivPerc   / 100) / syminfo.mintick : na
trailOff = useTrailStop ? (strategy.position_avg_price * trailOffsetPerc / 100) / syminfo.mintick : na

if riskActive and strategy.position_size > 0
    strategy.exit("Long Risk Exit", from_entry = "Long", stop = longStop, limit = longLimit, trail_points = trailPts, trail_offset = trailOff, comment = "Risk Exit")

if riskActive and strategy.position_size < 0
    strategy.exit("Short Risk Exit", from_entry = "Short", stop = shortStop, limit = shortLimit, trail_points = trailPts, trail_offset = trailOff, comment = "Risk Exit")

// ============================================================================
// PLOTS
// ============================================================================
plot(useStretchFilter ? stretchEma : na, title = "Stretch EMA", color = color.new(color.yellow, 30), force_overlay = true)
upperBandPlot = plot(useStretchFilter ? stretchUpper : na, title = "Stretch Upper Band", color = color.new(color.blue, 60), force_overlay = true)
lowerBandPlot = plot(useStretchFilter ? stretchLower : na, title = "Stretch Lower Band", color = color.new(color.blue, 60), force_overlay = true)
fill(upperBandPlot, lowerBandPlot, color = color.new(color.blue, 90), title = "Filtered Zone")
plot(showRSI ? rsi : na, title = "RSI", color = color.new(color.yellow, (rsi > ob or rsi < osLevel) ? 0 : 10))
obBand  = hline(ob,      title = "Overbought", color = color.new(color.red, 40))
osBand  = hline(osLevel, title = "Oversold",   color = color.new(color.green, 40))
midBand = hline(50,      title = "Midline",    color = color.new(color.white, 50))
fill(midBand, obBand, color = color.new(color.lime, 90))
fill(osBand, midBand, color = color.new(color.red, 90))

if showDiv and bearDiv
    label.new(bar_index - 1, rsi[1] + 1, "", color = bearFilterOk ? color.red : color.gray, textcolor = color.white, style = label.style_label_down, yloc = yloc.price, size = size.small)

if showDiv and bullDiv
    label.new(bar_index - 1, rsi[1] - 1, "", color = bullFilterOk ? color.green : color.gray, textcolor = color.white, style = label.style_label_up, yloc = yloc.price, size = size.small)

plotshape(showEntries and longSignal and canLong and cooldownOk, title = "Long Entry", style = shape.triangleup, location = location.bottom, color = color.green, size = size.tiny)
plotshape(showEntries and shortSignal and canShort and cooldownOk, title = "Short Entry", style = shape.triangledown, location = location.top, color = color.red, size = size.tiny)

plotshape(showExits and exitOnOppositeDiv and bearDiv and strategy.position_size > 0, title = "Long Exit (Opp. Div)", style = shape.xcross, location = location.top, color = color.orange, size = size.tiny)
plotshape(showExits and exitOnOppositeDiv and bullDiv and strategy.position_size < 0, title = "Short Exit (Opp. Div)", style = shape.xcross, location = location.bottom, color = color.orange, size = size.tiny)

// ============================================================================
// ALERTS
// ============================================================================
alertcondition(bearDiv,     title = "Bearish Divergence", message = "RSI Bearish Divergence")
alertcondition(bullDiv,     title = "Bullish Divergence",  message = "RSI Bullish Divergence")
alertcondition(longSignal,  title = "Long Signal",         message = "Long Entry Signal")
alertcondition(shortSignal, title = "Short Signal",        message = "Short Entry Signal")
